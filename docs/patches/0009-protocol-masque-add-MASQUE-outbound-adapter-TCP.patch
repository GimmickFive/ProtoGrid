--- /dev/null
+++ b/protocol/masque/outbound.go
@@ -0,0 +1,191 @@
+package masque
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/hex"
+	"net"
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	"github.com/xtls/xray-core/app/policy"
+	"github.com/xtls/xray-core/common/buf"
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/common/protocol"
+	"github.com/xtls/xray-core/common/serial"
+	"github.com/xtls/xray-core/common/session"
+	"github.com/xtls/xray-core/core"
+	xmasque "github.com/xtls/xray-core/proxy/masque"
+	"github.com/xtls/xray-core/transport"
+	"github.com/xtls/xray-core/transport/internet"
+	mtransport "github.com/xtls/xray-core/transport/internet/masque"
+	"github.com/xtls/xray-core/transport/internet/stat"
+	xtls "github.com/xtls/xray-core/transport/internet/tls"
+)
+
+func RegisterOutbound(registry *outbound.Registry) {
+	outbound.Register[option.MasqueOutboundOptions](registry, C.TypeMasque, NewOutbound)
+}
+
+type Outbound struct {
+	outbound.Adapter
+	client   *xmasque.Client
+	dialer   *masqueDialer
+	ctx      context.Context
+	settings *internet.MemoryStreamConfig
+}
+
+type masqueDialer struct {
+	settings *internet.MemoryStreamConfig
+}
+
+func (d *masqueDialer) Dial(ctx context.Context, destination xnet.Destination) (stat.Connection, error) {
+	return mtransport.Dial(ctx, destination, d.settings)
+}
+
+func (d *masqueDialer) DestIpAddress() net.IP                                 { return nil }
+func (d *masqueDialer) SetOutboundGateway(context.Context, *session.Outbound) {}
+
+func NewOutbound(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.MasqueOutboundOptions) (adapter.Outbound, error) {
+	_ = router
+	_ = logger
+	serverName := options.Server
+	if options.TLS != nil && options.TLS.ServerName != "" {
+		serverName = options.TLS.ServerName
+	}
+	xTLS := &xtls.Config{
+		ServerName:   serverName,
+		NextProtocol: []string{"h2"},
+	}
+	if options.PinnedPeerCertSha256 != "" {
+		pin, err := hex.DecodeString(options.PinnedPeerCertSha256)
+		if err != nil || len(pin) != 32 {
+			return nil, E.New("invalid pinned_peer_cert_sha256")
+		}
+		xTLS.PinnedPeerCertSha256 = [][]byte{pin}
+	}
+	headers := map[string]string{}
+	if options.User != "" || options.Pass != "" {
+		headers["Authorization"] = "Basic " + base64.StdEncoding.EncodeToString([]byte(options.User+":"+options.Pass))
+	}
+	settings := &internet.MemoryStreamConfig{
+		ProtocolName: "masque",
+		ProtocolSettings: &mtransport.Config{
+			Host:    options.Host,
+			Path:    options.Path,
+			Headers: headers,
+		},
+		SecurityType:     "tls",
+		SecuritySettings: xTLS,
+	}
+	instance, err := core.New(&core.Config{App: []*serial.TypedMessage{
+		serial.ToTypedMessage(&policy.Config{}),
+	}})
+	if err != nil {
+		return nil, E.Cause(err, "create Xray policy instance")
+	}
+	xrayCtx := context.WithValue(ctx, core.XrayKey(1), instance)
+	xrayCtx = session.ContextWithStreamSettings(xrayCtx, settings)
+	serverAddr := xnet.NewIPOrDomain(xnet.ParseAddress(options.Server))
+	client, err := xmasque.NewClient(xrayCtx, &xmasque.ClientConfig{
+		Server: &protocol.ServerEndpoint{
+			Address: serverAddr,
+			Port:    uint32(options.ServerPort),
+		},
+		RemoteDns: options.RemoteDNS,
+	})
+	if err != nil {
+		return nil, E.Cause(err, "create MASQUE client")
+	}
+	return &Outbound{
+		Adapter:  outbound.NewAdapter(C.TypeMasque, tag, []string{N.NetworkTCP}, nil),
+		client:   client,
+		dialer:   &masqueDialer{settings: settings},
+		ctx:      xrayCtx,
+		settings: settings,
+	}, nil
+}
+
+func (h *Outbound) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	switch N.NetworkName(network) {
+	case N.NetworkTCP:
+		return h.dial(ctx, destination, false)
+	case N.NetworkUDP:
+		conn, err := h.dial(ctx, destination, true)
+		if err != nil {
+			return nil, err
+		}
+		return conn, nil
+	default:
+		return nil, E.New("masque: unsupported network: ", network)
+	}
+}
+
+func (h *Outbound) dial(ctx context.Context, destination M.Socksaddr, udp bool) (*masqueConn, error) {
+	targetNetwork := xnet.Network_TCP
+	if udp {
+		targetNetwork = xnet.Network_UDP
+	}
+	target := xnet.Destination{
+		Network: targetNetwork,
+		Address: xnet.ParseAddress(destination.AddrString()),
+		Port:    xnet.Port(destination.Port),
+	}
+	ctx = session.ContextWithOutbounds(ctx, []*session.Outbound{{Target: target}})
+	local, remote := net.Pipe()
+	link := &transport.Link{
+		Reader: buf.NewReader(remote),
+		Writer: buf.NewWriter(remote),
+	}
+	go func() {
+		_ = h.client.Process(ctx, link, h.dialer)
+		_ = remote.Close()
+		_ = local.Close()
+	}()
+	return &masqueConn{Conn: local, destination: destination}, nil
+}
+
+type masqueConn struct {
+	net.Conn
+	destination M.Socksaddr
+}
+
+func (c *masqueConn) LocalAddr() net.Addr              { return masqueAddr("masque-local") }
+func (c *masqueConn) RemoteAddr() net.Addr             { return masqueAddr(c.destination.String()) }
+func (c *masqueConn) SetDeadline(time.Time) error      { return nil }
+func (c *masqueConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *masqueConn) SetWriteDeadline(time.Time) error { return nil }
+
+type masqueAddr string
+
+func (a masqueAddr) Network() string { return "masque" }
+func (a masqueAddr) String() string  { return string(a) }
+
+func (h *Outbound) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	conn, err := h.dial(ctx, destination, true)
+	if err != nil {
+		return nil, err
+	}
+	return &masquePacketConn{masqueConn: conn}, nil
+}
+
+type masquePacketConn struct {
+	*masqueConn
+}
+
+func (c *masquePacketConn) ReadFrom(buffer []byte) (int, net.Addr, error) {
+	n, err := c.Read(buffer)
+	return n, c.RemoteAddr(), err
+}
+
+func (c *masquePacketConn) WriteTo(buffer []byte, _ net.Addr) (int, error) {
+	return c.Write(buffer)
+}
