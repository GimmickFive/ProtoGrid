From c41dbdf3e2e29dce1ccb5306050c1162ddf22144 Mon Sep 17 00:00:00 2001
From: ProtoGrid Fork <protogrid@localhost>
Date: Wed, 25 Nov 2026 06:50:26 +0300
Subject: [PATCH 06/12] v2rayxhttp: batch packet-up, add HTTP/3 and Xray
 options

---
 option/v2ray_transport.go      |  16 +++
 option/v2ray_transport_test.go |   7 ++
 transport/v2rayxhttp/client.go | 192 +++++++++++++++++++++++++--------
 3 files changed, 168 insertions(+), 47 deletions(-)

diff --git a/option/v2ray_transport.go b/option/v2ray_transport.go
index 2317da1..87a940a 100644
--- a/option/v2ray_transport.go
+++ b/option/v2ray_transport.go
@@ -1,6 +1,7 @@
 package option
 
 import (
+	stdjson "encoding/json"
 	"reflect"
 
 	C "github.com/sagernet/sing-box/constant"
@@ -139,6 +140,21 @@ type V2RayXHTTPOptions struct {
 	ScMaxEachPostBytes int `json:"sc_max_each_post_bytes,omitempty"`
 	// ScMinPostsIntervalMs batches small writes before a POST. Defaults to 30 ms.
 	ScMinPostsIntervalMs int `json:"sc_min_posts_interval_ms,omitempty"`
+	// Xmux is accepted for Xray compatibility. HTTP/2 and HTTP/3 connection
+	// pooling already provides multiplexing.
+	Xmux *V2RayXHTTPXmuxOptions `json:"xmux,omitempty"`
+	// DownloadSettings is accepted for Xray compatibility. The current client
+	// keeps the downlink on the main server.
+	DownloadSettings stdjson.RawMessage `json:"download_settings,omitempty"`
+}
+
+type V2RayXHTTPXmuxOptions struct {
+	MaxConcurrency   int `json:"max_concurrency,omitempty"`
+	MaxConnections   int `json:"max_connections,omitempty"`
+	CMaxReuseTimes   int `json:"c_max_reuse_times,omitempty"`
+	HMaxRequestTimes int `json:"h_max_request_times,omitempty"`
+	HMaxReusableSecs int `json:"h_max_reusable_secs,omitempty"`
+	HKeepAlivePeriod int `json:"h_keep_alive_period,omitempty"`
 }
 
 // V2RayKCPOptions configures the client side of mKCP.
diff --git a/option/v2ray_transport_test.go b/option/v2ray_transport_test.go
index 7ac6587..4eeba18 100644
--- a/option/v2ray_transport_test.go
+++ b/option/v2ray_transport_test.go
@@ -20,6 +20,13 @@ func TestV2RayXHTTPOptionsRoundTrip(t *testing.T) {
 	require.Equal(t, "stream-up", transport.XHTTPOptions.Mode)
 	require.Equal(t, "1", transport.XHTTPOptions.Headers.Build().Get("X-Test"))
 
+	xmuxTransport := V2RayTransportOptions{}
+	err = json.Unmarshal([]byte(`{"type":"xhttp","mode":"packet-up","xmux":{"max_concurrency":8},"download_settings":{"host":"cdn.example.com"}}`), &xmuxTransport)
+	require.NoError(t, err)
+	require.NotNil(t, xmuxTransport.XHTTPOptions.Xmux)
+	require.Equal(t, 8, xmuxTransport.XHTTPOptions.Xmux.MaxConcurrency)
+	require.NotEmpty(t, xmuxTransport.XHTTPOptions.DownloadSettings)
+
 	encoded, err := json.Marshal(transport)
 	require.NoError(t, err)
 	require.JSONEq(t, `{"type":"xhttp","host":"example.com","path":"/x","mode":"stream-up","headers":{"X-Test":"1"}}`, string(encoded))
diff --git a/transport/v2rayxhttp/client.go b/transport/v2rayxhttp/client.go
index 5991de5..ff77f99 100644
--- a/transport/v2rayxhttp/client.go
+++ b/transport/v2rayxhttp/client.go
@@ -4,6 +4,7 @@ import (
 	"bytes"
