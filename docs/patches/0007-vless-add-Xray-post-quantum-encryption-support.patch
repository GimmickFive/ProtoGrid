index 0000000..dff68bc
--- /dev/null
+++ b/protocol/vless/encryption.go
@@ -0,0 +1,74 @@
+package vless
+
+import (
+	"encoding/base64"
+	"strings"
+
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+type parsedEncryption struct {
+	keys    [][]byte
+	xorMode uint32
+	seconds uint32
+	padding string
+}
+
+// parseEncryption accepts both Xray's full `mlkem768x25519plus...` string and
+// a plain dot-separated key list.
+func parseEncryption(raw string) (*parsedEncryption, error) {
+	if raw == "" || raw == "none" {
+		return nil, nil
+	}
+	parts := strings.Split(raw, ".")
+	parsed := &parsedEncryption{}
+	keyParts := parts
+	if len(parts) >= 4 && parts[0] == "mlkem768x25519plus" {
+		switch parts[1] {
+		case "native":
+		case "xorpub":
+			parsed.xorMode = 1
+		case "random":
+			parsed.xorMode = 2
+		default:
+			return nil, E.New("unknown VLESS encryption xor mode: ", parts[1])
+		}
+		switch parts[2] {
+		case "1rtt":
+		case "0rtt":
+			parsed.seconds = 1
+		default:
+			return nil, E.New("unknown VLESS encryption RTT mode: ", parts[2])
+		}
+		keyParts = parts[3:]
+		paddingLength := 0
+		for _, part := range keyParts {
+			if len(part) < 20 {
+				paddingLength += len(part) + 1
+			}
+		}
+		tail := strings.Join(keyParts, ".")
+		if paddingLength > 0 {
+			if paddingLength > len(tail) {
+				return nil, E.New("invalid VLESS encryption padding")
+			}
+			parsed.padding = tail[:paddingLength-1]
+			tail = tail[paddingLength:]
+		}
+		keyParts = strings.Split(tail, ".")
+	}
+	for _, part := range keyParts {
+		key, err := base64.RawURLEncoding.DecodeString(part)
+		if err != nil {
+			return nil, E.Cause(err, "decode VLESS encryption key")
+		}
+		if len(key) != 32 && len(key) != 1184 {
+			return nil, E.New("invalid VLESS encryption key length: ", len(key))
+		}
+		parsed.keys = append(parsed.keys, key)
+	}
+	if len(parsed.keys) == 0 {
+		return nil, E.New("empty VLESS encryption key list")
+	}
+	return parsed, nil
+}
diff --git a/protocol/vless/encryption_test.go b/protocol/vless/encryption_test.go
new file mode 100644
index 0000000..3bfc6e6
--- /dev/null
+++ b/protocol/vless/encryption_test.go
@@ -0,0 +1,25 @@
+package vless
+
+import "testing"
+
+func TestParseEncryption(t *testing.T) {
+	t.Parallel()
+	parsed, err := parseEncryption("mlkem768x25519plus.native.0rtt.L-szld8wMtMX2g8EfuLJiOHmG1Iqei6ZDjSdsSWHPCY")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if parsed == nil || len(parsed.keys) != 1 || len(parsed.keys[0]) != 32 {
+		t.Fatalf("unexpected keys: %+v", parsed)
+	}
+	if parsed.xorMode != 0 || parsed.seconds != 1 {
+		t.Fatalf("unexpected mode: %+v", parsed)
+	}
+}
+
+func TestParseEncryptionNone(t *testing.T) {
+	t.Parallel()
+	parsed, err := parseEncryption("none")
+	if err != nil || parsed != nil {
+		t.Fatalf("unexpected result: %+v %v", parsed, err)
+	}
+}
