@@ -0,0 +1,16 @@
+package option
+
+import "encoding/json"
+
+// FinalMaskOptions mirrors Xray's finalmask stream option. Only UDP masks are
+// implemented; TCP transports do not have a mask hook in sing-box yet.
+type FinalMaskOptions struct {
+	UDP []FinalMaskUDPOptions `json:"udp,omitempty"`
+}
+
+// FinalMaskUDPOptions is a single UDP mask entry. Settings stays raw so that
+// the mask decoder can accept Xray's schemas (string or numeric ranges).
+type FinalMaskUDPOptions struct {
+	Type     string          `json:"type"`
+	Settings json.RawMessage `json:"settings,omitempty"`
+}
