+// V2RayXHTTPOptions is the client configuration for the XHTTP transport.
+// The first implementation supports stream-one and stream-up over HTTP/2.
+type V2RayXHTTPOptions struct {
+	Host    string               `json:"host,omitempty"`
+	Path    string               `json:"path,omitempty"`
+	Headers badoption.HTTPHeader `json:"headers,omitempty"`
+	// Mode is one of "auto", "stream-one", "stream-up" or "packet-up".
+	// Empty and "auto" currently map to stream-one.
+	Mode string `json:"mode,omitempty"`
+}
diff --git a/option/v2ray_transport_test.go b/option/v2ray_transport_test.go
new file mode 100644
index 0000000..7ac6587
--- /dev/null
+++ b/option/v2ray_transport_test.go
@@ -0,0 +1,26 @@
+package option
+
+import (
+	"testing"
+
+	"github.com/sagernet/sing/common/json"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestV2RayXHTTPOptionsRoundTrip(t *testing.T) {
+	t.Parallel()
+
+	var transport V2RayTransportOptions
+	err := json.Unmarshal([]byte(`{"type":"xhttp","host":"example.com","path":"/x","mode":"stream-up","headers":{"X-Test":"1"}}`), &transport)
+	require.NoError(t, err)
+	require.Equal(t, "xhttp", transport.Type)
+	require.Equal(t, "example.com", transport.XHTTPOptions.Host)
+	require.Equal(t, "/x", transport.XHTTPOptions.Path)
+	require.Equal(t, "stream-up", transport.XHTTPOptions.Mode)
+	require.Equal(t, "1", transport.XHTTPOptions.Headers.Build().Get("X-Test"))
+
+	encoded, err := json.Marshal(transport)
+	require.NoError(t, err)
+	require.JSONEq(t, `{"type":"xhttp","host":"example.com","path":"/x","mode":"stream-up","headers":{"X-Test":"1"}}`, string(encoded))
+}
