+	mldsa65Verify []byte
 	// x25519Only is set for the fallback attempt used with servers that do
 	// not understand X25519MLKEM768 (Xray <= 25).
 	x25519Only bool
@@ -87,8 +88,15 @@ func newRealityClient(ctx context.Context, logger logger.ContextLogger, serverAd
 	if decodedLen > 8 {
 		return nil, E.New("invalid short_id")
 	}
+	var mldsa65Verify []byte
+	if options.Reality.Mldsa65Verify != "" {
+		mldsa65Verify, err = base64.RawURLEncoding.DecodeString(options.Reality.Mldsa65Verify)
+		if err != nil || len(mldsa65Verify) != 1952 {
+			return nil, E.New("invalid mldsa65_verify")
+		}
+	}
 
-	var config Config = &RealityClientConfig{ctx, uClient.(*UTLSClientConfig), publicKey, shortID, false}
+	var config Config = &RealityClientConfig{ctx, uClient.(*UTLSClientConfig), publicKey, shortID, mldsa65Verify, false}
 	if options.KernelRx || options.KernelTx {
 		if !C.IsLinux {
 			return nil, E.New("kTLS is only supported on Linux")
@@ -147,7 +155,8 @@ func (e *RealityClientConfig) Client(conn net.Conn) (Conn, error) {
 
 func (e *RealityClientConfig) ClientHandshake(ctx context.Context, conn net.Conn) (aTLS.Conn, error) {
 	verifier := &realityVerifier{
-		serverName: e.uClient.ServerName(),
+		serverName:    e.uClient.ServerName(),
+		mldsa65Verify: e.mldsa65Verify,
 	}
 	uConfig := e.uClient.config.Clone()
 	uConfig.InsecureSkipVerify = true
@@ -298,15 +307,17 @@ func (e *RealityClientConfig) Clone() Config {
 		e.uClient.Clone().(*UTLSClientConfig),
 		e.publicKey,
 		e.shortID,
+		e.mldsa65Verify,
 		e.x25519Only,
 	}
 }
 
 type realityVerifier struct {
 	*utls.UConn
-	serverName string
-	authKey    []byte
-	verified   bool
+	serverName    string
+	authKey       []byte
+	mldsa65Verify []byte
+	verified      bool
 }
 
 func (c *realityVerifier) VerifyPeerCertificate(rawCerts [][]byte, verifiedChains [][]*x509.Certificate) error {
@@ -316,8 +327,18 @@ func (c *realityVerifier) VerifyPeerCertificate(rawCerts [][]byte, verifiedChain
 		h := hmac.New(sha512.New, c.authKey)
 		h.Write(pub)
 		if bytes.Equal(h.Sum(nil), certs[0].Signature) {
-			c.verified = true
-			return nil
+			if len(c.mldsa65Verify) == 0 {
+				c.verified = true
+				return nil
+			}
+			if len(certs[0].Extensions) > 0 && c.UConn != nil && c.UConn.HandshakeState.Hello != nil && c.UConn.HandshakeState.ServerHello != nil {
+				h.Write(c.UConn.HandshakeState.Hello.Raw)
+				h.Write(c.UConn.HandshakeState.ServerHello.Raw)
+				if verifyMldsa65(c.mldsa65Verify, h.Sum(nil), certs[0].Extensions[0].Value) {
+					c.verified = true
+					return nil
+				}
+			}
 		}
 	}
 	opts := x509.VerifyOptions{
diff --git a/common/tls/reality_mldsa.go b/common/tls/reality_mldsa.go
new file mode 100644
index 0000000..418fbf8
--- /dev/null
+++ b/common/tls/reality_mldsa.go
@@ -0,0 +1,13 @@
+//go:build go1.27
+
+package tls
+
+import "crypto/mldsa"
+
+func verifyMldsa65(publicKey []byte, message []byte, signature []byte) bool {
+	key, err := mldsa.NewPublicKey(mldsa.MLDSA65(), publicKey)
+	if err != nil {
+		return false
+	}
+	return mldsa.Verify(key, message, signature, nil) == nil
+}
