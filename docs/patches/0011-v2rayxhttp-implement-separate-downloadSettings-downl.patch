From b46910b34ea7ebcb0bd53b64742e8ebe4d522d90 Mon Sep 17 00:00:00 2001
From: ProtoGrid Fork <protogrid@localhost>
Date: Wed, 25 Nov 2026 08:06:11 +0300
Subject: [PATCH 11/12] v2rayxhttp: implement separate downloadSettings
 downlink

---
 option/v2ray_transport.go      |  26 ++++++--
 option/v2ray_transport_test.go |   6 +-
 transport/v2rayxhttp/client.go | 115 +++++++++++++++++++++++++++------
 3 files changed, 121 insertions(+), 26 deletions(-)

diff --git a/option/v2ray_transport.go b/option/v2ray_transport.go
index a91790e..d332608 100644
--- a/option/v2ray_transport.go
+++ b/option/v2ray_transport.go
@@ -1,7 +1,6 @@
 package option
 
 import (
-	stdjson "encoding/json"
 	"reflect"
 
 	C "github.com/sagernet/sing-box/constant"
@@ -149,9 +148,28 @@ type V2RayXHTTPOptions struct {
 	// Xmux is accepted for Xray compatibility. HTTP/2 and HTTP/3 connection
 	// pooling already provides multiplexing.
 	Xmux *V2RayXHTTPXmuxOptions `json:"xmux,omitempty"`
-	// DownloadSettings is accepted for Xray compatibility. The current client
-	// keeps the downlink on the main server.
-	DownloadSettings stdjson.RawMessage `json:"download_settings,omitempty"`
+	// DownloadSettings is accepted for Xray compatibility. The download half
+	// may use a separate address, host and path.
+	DownloadSettings *V2RayXHTTPDownloadOptions `json:"download_settings,omitempty"`
+}
+
+type V2RayXHTTPDownloadOptions struct {
+	Address       string                              `json:"address,omitempty"`
+	Port          int                                 `json:"port,omitempty"`
+	Security      string                              `json:"security,omitempty"`
+	TLSSettings   *V2RayXHTTPDownloadTLSOptions       `json:"tls_settings,omitempty"`
+	XHTTPSettings *V2RayXHTTPDownloadTransportOptions `json:"xhttp_settings,omitempty"`
+}
+
+type V2RayXHTTPDownloadTLSOptions struct {
+	ServerName string   `json:"server_name,omitempty"`
+	Insecure   bool     `json:"insecure,omitempty"`
+	ALPN       []string `json:"alpn,omitempty"`
+}
+
+type V2RayXHTTPDownloadTransportOptions struct {
+	Host string `json:"host,omitempty"`
+	Path string `json:"path,omitempty"`
 }
 
 type V2RayXHTTPXmuxOptions struct {
