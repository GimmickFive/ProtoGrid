-	err = json.Unmarshal([]byte(`{"type":"xhttp","mode":"packet-up","xmux":{"max_concurrency":8},"download_settings":{"host":"cdn.example.com"}}`), &xmuxTransport)
+	err = json.Unmarshal([]byte(`{"type":"xhttp","mode":"packet-up","xmux":{"max_concurrency":8},"download_settings":{"address":"cdn.example.com","port":443,"xhttp_settings":{"path":"/dl","host":"dl.example.com"}}}`), &xmuxTransport)
 	require.NoError(t, err)
 	require.NotNil(t, xmuxTransport.XHTTPOptions.Xmux)
 	require.Equal(t, 8, xmuxTransport.XHTTPOptions.Xmux.MaxConcurrency)
-	require.NotEmpty(t, xmuxTransport.XHTTPOptions.DownloadSettings)
+	require.NotNil(t, xmuxTransport.XHTTPOptions.DownloadSettings)
+	require.Equal(t, "cdn.example.com", xmuxTransport.XHTTPOptions.DownloadSettings.Address)
+	require.Equal(t, "/dl", xmuxTransport.XHTTPOptions.DownloadSettings.XHTTPSettings.Path)
 
 	encoded, err := json.Marshal(transport)
 	require.NoError(t, err)
diff --git a/transport/v2rayxhttp/client.go b/transport/v2rayxhttp/client.go
index ff77f99..2d53a4d 100644
--- a/transport/v2rayxhttp/client.go
+++ b/transport/v2rayxhttp/client.go
@@ -52,6 +52,10 @@ type Client struct {
 	transport  http.RoundTripper
 	h3         *http3.Transport
 	httpClient *http.Client
+
+	downloadURL    *url.URL
+	downloadHost   string
+	downloadClient *http.Client
 }
 
 func NewClient(ctx context.Context, dialer N.Dialer, serverAddr M.Socksaddr, options option.V2RayXHTTPOptions, tlsConfig tls.Config) (*Client, error) {
@@ -151,17 +155,71 @@ func NewClient(ctx context.Context, dialer N.Dialer, serverAddr M.Socksaddr, opt
 		}
 	}
 
+	var downloadURL *url.URL
+	var downloadHost string
+	var downloadClient *http.Client
+	if options.DownloadSettings != nil {
+		if useH3 {
+			return nil, E.New("v2ray-xhttp: download_settings with HTTP/3 is not supported")
+		}
+		download := options.DownloadSettings
+		address := download.Address
+		if address == "" {
+			address = serverAddr.AddrString()
+		}
+		port := uint16(download.Port)
+		if port == 0 {
+			port = serverAddr.Port
+		}
+		downloadTLS := tlsConfig.Clone()
+		if download.TLSSettings != nil {
+			if download.TLSSettings.ServerName != "" {
+				downloadTLS.SetServerName(download.TLSSettings.ServerName)
+			}
+			if len(download.TLSSettings.ALPN) > 0 {
+				downloadTLS.SetNextProtos(download.TLSSettings.ALPN)
+			}
+		}
+		downloadServer := M.ParseSocksaddrHostPort(address, port)
+		downloadDialer := tls.NewDialer(dialer, downloadTLS)
+		downloadClient = &http.Client{Transport: &http2.Transport{
+			DialTLSContext: func(dialCtx context.Context, network string, addr string, cfg *tls.STDConfig) (net.Conn, error) {
+				return downloadDialer.DialTLSContext(adapter.ContextForMultiplexSession(dialCtx), downloadServer)
+			},
+		}}
+		downloadHost = host
+		downloadPath := path
+		if download.XHTTPSettings != nil {
+			if download.XHTTPSettings.Host != "" {
+				downloadHost = download.XHTTPSettings.Host
+			}
+			if download.XHTTPSettings.Path != "" {
+				downloadPath = download.XHTTPSettings.Path
+			}
+		}
+		if !strings.HasPrefix(downloadPath, "/") {
+			downloadPath = "/" + downloadPath
+		}
+		if !strings.HasSuffix(downloadPath, "/") {
+			downloadPath += "/"
+		}
+		downloadURL = &url.URL{Scheme: "https", Host: downloadHost, Path: downloadPath}
+	}
+
 	return &Client{
-		ctx:        ctx,
-		serverAddr: serverAddr,
-		options:    options,
-		baseURL:    baseURL,
-		host:       host,
-		headers:    headers,
-		mode:       mode,
-		transport:  roundTripper,
-		h3:         h3Transport,
-		httpClient: &http.Client{Transport: roundTripper},
+		ctx:            ctx,
+		serverAddr:     serverAddr,
+		options:        options,
+		baseURL:        baseURL,
+		host:           host,
+		headers:        headers,
+		mode:           mode,
+		transport:      roundTripper,
+		h3:             h3Transport,
+		httpClient:     &http.Client{Transport: roundTripper},
+		downloadURL:    downloadURL,
+		downloadHost:   downloadHost,
+		downloadClient: downloadClient,
 	}, nil
 }
 
