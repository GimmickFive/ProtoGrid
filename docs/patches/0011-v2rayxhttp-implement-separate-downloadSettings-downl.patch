 }
 
+func (c *Client) downlink(sessionID string) (url.URL, *http.Client, string) {
+	if c.downloadURL != nil {
+		downURL := *c.downloadURL
+		downURL.Path = appendPath(c.downloadURL.Path, sessionID)
+		return downURL, c.downloadClient, c.downloadHost
+	}
+	downURL := c.baseURL
+	downURL.Path = appendPath(c.baseURL.Path, sessionID)
+	return downURL, c.httpClient, c.host
+}
+
 func (c *Client) applyPadding(request *http.Request) {
 	padding := randomPadding()
 	referer := c.baseURL
@@ -356,6 +426,11 @@ func (c *Client) Close() error {
 	if h2, isH2 := c.transport.(*http2.Transport); isH2 {
 		h2.CloseIdleConnections()
 	}
+	if c.downloadClient != nil {
+		if h2, isH2 := c.downloadClient.Transport.(*http2.Transport); isH2 {
+			h2.CloseIdleConnections()
+		}
+	}
 	return nil
 }
 
