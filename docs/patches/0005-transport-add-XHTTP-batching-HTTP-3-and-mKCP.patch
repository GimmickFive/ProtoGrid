+++ b/transport/v2raykcp/client.go
@@ -0,0 +1,84 @@
+package v2raykcp
+
+import (
+	"context"
+	"net"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/tls"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/kcp"
+)
+
+var _ adapter.V2RayClientTransport = (*Client)(nil)
+
+// Client adapts Xray's mKCP transport to the sing-box V2Ray transport
+// interface. Xray's implementation is used directly so the wire protocol stays
+// compatible with Xray servers.
+type Client struct {
+	ctx        context.Context
+	serverAddr M.Socksaddr
+	options    option.V2RayKCPOptions
+	tlsConfig  tls.Config
+}
+
+func NewClient(ctx context.Context, dialer N.Dialer, serverAddr M.Socksaddr, options option.V2RayKCPOptions, tlsConfig tls.Config) (*Client, error) {
+	_ = dialer
+	return &Client{
+		ctx:        ctx,
+		serverAddr: serverAddr,
+		options:    options,
+		tlsConfig:  tlsConfig,
+	}, nil
+}
+
+func (c *Client) DialContext(ctx context.Context) (net.Conn, error) {
+	destination := xnet.UDPDestination(
+		xnet.ParseAddress(c.serverAddr.AddrString()),
+		xnet.Port(c.serverAddr.Port),
+	)
+	settings := &kcp.Config{}
+	if c.options.MTU > 0 {
+		settings.Mtu = &kcp.MTU{Value: uint32(c.options.MTU)}
+	}
+	if c.options.TTI > 0 {
+		settings.Tti = &kcp.TTI{Value: uint32(c.options.TTI)}
+	}
+	if c.options.UplinkCapacity > 0 {
+		settings.UplinkCapacity = &kcp.UplinkCapacity{Value: uint32(c.options.UplinkCapacity)}
+	}
+	if c.options.DownlinkCapacity > 0 {
+		settings.DownlinkCapacity = &kcp.DownlinkCapacity{Value: uint32(c.options.DownlinkCapacity)}
+	}
+	if c.options.MaxSendingWindow > 0 {
+		settings.WriteBuffer = &kcp.WriteBuffer{Size: uint32(c.options.MaxSendingWindow)}
+	}
+	settings.Congestion = c.options.Congestion
+
+	conn, err := kcp.DialKCP(ctx, destination, &internet.MemoryStreamConfig{
+		ProtocolName:     "mkcp",
+		ProtocolSettings: settings,
+	})
+	if err != nil {
+		return nil, E.Cause(err, "v2ray-kcp: dial")
+	}
+	if c.tlsConfig != nil {
+		tlsConn, err := c.tlsConfig.Client(conn)
+		if err != nil {
+			_ = conn.Close()
+			return nil, E.Cause(err, "v2ray-kcp: tls")
+		}
+		return tlsConn, nil
+	}
+	return conn, nil
+}
+
+func (c *Client) Close() error {
+	return nil
+}
