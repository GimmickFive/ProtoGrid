diff --git a/transport/v2rayxdrive/client.go b/transport/v2rayxdrive/client.go
new file mode 100644
index 0000000..343640c
--- /dev/null
+++ b/transport/v2rayxdrive/client.go
@@ -0,0 +1,67 @@
+package v2rayxdrive
+
+import (
+	"context"
+	"net"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/tls"
+	"github.com/sagernet/sing-box/option"
+	E "github.com/sagernet/sing/common/exceptions"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+
+	xnet "github.com/xtls/xray-core/common/net"
+	"github.com/xtls/xray-core/transport/internet"
+	"github.com/xtls/xray-core/transport/internet/xdrive"
+)
+
+var _ adapter.V2RayClientTransport = (*Client)(nil)
+
+// Client adapts Xray's XDRIVE transport to the sing-box V2Ray transport
+// interface.
+type Client struct {
+	serverAddr M.Socksaddr
+	options    option.V2RayXDriveOptions
+}
+
+func NewClient(ctx context.Context, dialer N.Dialer, serverAddr M.Socksaddr, options option.V2RayXDriveOptions, tlsConfig tls.Config) (*Client, error) {
+	_ = ctx
+	_ = dialer
+	_ = tlsConfig
+	return &Client{
+		serverAddr: serverAddr,
+		options:    options,
+	}, nil
+}
+
+func (c *Client) DialContext(ctx context.Context) (net.Conn, error) {
+	destination := xnet.TCPDestination(
+		xnet.ParseAddress(c.serverAddr.AddrString()),
+		xnet.Port(c.serverAddr.Port),
+	)
+	conn, err := xdrive.Dial(ctx, destination, &internet.MemoryStreamConfig{
+		ProtocolName: "xdrive",
+		ProtocolSettings: &xdrive.Config{
+			RemoteFolder:      c.options.RemoteFolder,
+			Service:           c.options.Service,
+			Secrets:           c.options.Secrets,
+			SegmentBytes:      c.options.SegmentBytes,
+			FlushIntervalMs:   c.options.FlushIntervalMs,
+			PollIntervalMs:    c.options.PollIntervalMs,
+			MaxPollIntervalMs: c.options.MaxPollIntervalMs,
+			SessionTtlSeconds: c.options.SessionTTLSeconds,
+			Concurrency:       c.options.Concurrency,
+			EagerWindowMs:     c.options.EagerWindowMs,
+			HoleTimeoutMs:     c.options.HoleTimeoutMs,
+		},
+	})
+	if err != nil {
+		return nil, E.Cause(err, "v2ray-xdrive: dial")
+	}
+	return conn, nil
+}
+
+func (c *Client) Close() error {
+	return nil
+}
